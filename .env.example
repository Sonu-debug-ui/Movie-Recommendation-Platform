# ========================================================
# CineFlix - Environment Configuration Template
# Duplicate this file as .env and fill in your credentials
# ========================================================

# Supabase Configuration
# Obtain from: https://supabase.com -> Your Project -> Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# TMDB (The Movie Database) Configuration (Optional / Fallback)
# Obtain free API key from: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your-tmdb-api-key-here
